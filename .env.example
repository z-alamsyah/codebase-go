# Copy to .env for local development:  cp .env.example .env
# docker-compose files read the same .env, so ports and credentials stay in sync.

# ---------------------------------------------------------------- App
APP_NAME=codebase-go
APP_ENV=local                       # local | staging | production
APP_VERSION=dev
APP_SHUTDOWN_TIMEOUT=15s            # max time to drain requests/messages on SIGTERM

# ---------------------------------------------------------------- HTTP / REST
# The HTTP server always runs (it serves /healthz and /readyz).
# REST_ENABLED only toggles the business routes under /api.
REST_ENABLED=true
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_REQUEST_TIMEOUT=10s
HTTP_TRUSTED_PROXIES=0              # proxies in front of the app; 0 = ignore X-Forwarded-For (cannot be spoofed)

# ---------------------------------------------------------------- gRPC
GRPC_ENABLED=false
GRPC_PORT=9090
GRPC_REFLECTION_ENABLED=true        # lets grpcurl list services; disable in production if not needed

# ---------------------------------------------------------------- Logging
LOG_LEVEL=info                      # debug | info | warn | error (debug adds headers, response body, SQL, source line)
LOG_FORMAT=pretty                   # pretty (colored, local) | json (servers, log collectors)
LOG_REDACT_KEYS=password,token,access_token,refresh_token,secret,authorization,cookie,pin,otp,cvv,card_number
LOG_BODY_MAX_BYTES=4096             # payloads are cut after redaction

# ---------------------------------------------------------------- PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=codebase_go
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_SLOW_QUERY_THRESHOLD=200ms       # slower queries are logged as warnings

# ---------------------------------------------------------------- Redis
REDIS_ADDR=localhost:6379
REDIS_PORT=6379                     # used by docker-compose only
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=5m

# ---------------------------------------------------------------- Message broker (RabbitMQ)
# MQ_ENABLED connects to the broker and enables the event publisher.
MQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=codebase-go.events

# CONSUMER_ENABLED runs the consumer workers. Requires MQ_ENABLED=true.
CONSUMER_ENABLED=false
CONSUMER_PREFETCH=10                # messages processed in parallel per queue
CONSUMER_MAX_RETRIES=3              # then the message goes to <queue>.dlq
CONSUMER_RETRY_DELAY=5s             # wait before each retry

# ---------------------------------------------------------------- OpenTelemetry
# When enabled, traces, metrics and logs are exported over OTLP.
# The OTEL_* names are the standard ones; the OTel SDK reads them directly.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317   # http:// = no TLS
OTEL_SERVICE_NAME=codebase-go
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0                          # 1.0 = keep every trace; lower it in production
OTEL_METRIC_EXPORT_INTERVAL=15000                    # ms; SDK default is 60000
# OTEL_RESOURCE_ATTRIBUTES=team=backend
